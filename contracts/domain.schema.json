{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "超慢跑个体处方引擎领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SCREENING_APPROVED",
        "PLAN_PUBLISHED",
        "SESSION_LOGGED",
        "SAFETY_PAUSED",
        "PLAN_RESUMED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "participant_screening",
        "exercise_plan",
        "training_session",
        "safety_report"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
